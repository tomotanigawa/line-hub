<plist version="1.0">
<dict>
  <key>Label</key><string>local.clienthub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>__ROOT__/hub/poller.mjs</string>
